#!/usr/bin/env bash
# bump-version — update the Get Clear suite version and trigger a release build
#
# Always updates suiteVersion in all Version.swift files.
# Optionally updates builtVersion for specific tools.
#
# Usage:
#   ./scripts/bump-version <suite-version> [tool:version ...]
#
# Examples:
#   ./scripts/bump-version 1.4.0                        # suite only
#   ./scripts/bump-version 1.4.0 reminders:1.4.0        # suite + one tool
#   ./scripts/bump-version 1.4.0 reminders:1.4.0 calendar:1.3.1

set -euo pipefail

NEW_SUITE="$1"

if [[ -z "$NEW_SUITE" ]]; then
  echo "Usage: ./scripts/bump-version <suite-version> [tool:version ...]"
  echo "Current suite: $(cat VERSION)"
  exit 1
fi

# Parse tool:version overrides from remaining args
declare -A TOOL_VERSIONS
shift
for arg in "$@"; do
  tool="${arg%%:*}"
  ver="${arg##*:}"
  TOOL_VERSIONS["$tool"]="$ver"
done

OLD_SUITE=$(cat VERSION)

if [[ "$NEW_SUITE" == "$OLD_SUITE" && ${#TOOL_VERSIONS[@]} -eq 0 ]]; then
  echo "Already at $NEW_SUITE — nothing to do."
  exit 0
fi

TOOL_NAMES=(reminders calendar contacts mail text)
TOOL_DIRS=(reminders-cli calendar-cli contacts-cli mail-cli text-cli)
TOOL_SOURCES=(RemindersCLI CalendarCLI ContactsCLI MailCLI TextCLI)
TOOL_SUMMARIES=(
  "CLI for Apple Reminders"
  "CLI for Apple Calendar"
  "CLI for Apple Contacts"
  "CLI for Apple Mail"
  "CLI for Apple Messages"
)

VERSION_HEADER="// Generated — do not edit manually. Use scripts/bump-version in get-clear."

# ── Update GetClearKit suite version ──────────────────────────────────────────

echo "$NEW_SUITE" > VERSION
printf "%s\npublic let suiteVersion = \"%s\"\n" \
  "$VERSION_HEADER" "$NEW_SUITE" \
  > Sources/GetClearKit/SuiteVersion.swift
echo "suiteVersion: $OLD_SUITE → $NEW_SUITE"

# ── Update get-clear umbrella ──────────────────────────────────────────────────

cat > Sources/GetClear/Version.swift << SWIFT
$VERSION_HEADER
import GetClearKit
let builtVersion = "$NEW_SUITE"
let identity = ToolIdentity(
    tool: "get-clear",
    built: builtVersion,
    summary: "Five tools for macOS. Claude as the conductor."
)
SWIFT
echo "get-clear: $OLD_SUITE → $NEW_SUITE"

# ── Update each tool ──────────────────────────────────────────────────────────

for i in "${!TOOL_NAMES[@]}"; do
  name="${TOOL_NAMES[$i]}"
  dir="${TOOL_DIRS[$i]}"
  src="${TOOL_SOURCES[$i]}"
  summary="${TOOL_SUMMARIES[$i]}"
  version_file="$dir/Sources/$src/Version.swift"
  old_built=$(grep 'let builtVersion' "$version_file" | grep -o '"[^"]*"' | tr -d '"')

  if [[ -v TOOL_VERSIONS[$name] ]]; then
    new_built="${TOOL_VERSIONS[$name]}"
  else
    new_built="$old_built"
  fi

  cat > "$version_file" << SWIFT
$VERSION_HEADER
import GetClearKit
let builtVersion = "$new_built"
let identity = ToolIdentity(
    tool: "$name",
    built: builtVersion,
    summary: "$summary"
)
SWIFT

  if [[ "$new_built" != "$old_built" ]]; then
    echo "  $name: $old_built → $new_built (suite $NEW_SUITE)"
  else
    echo "  $name: $old_built unchanged, suite → $NEW_SUITE"
  fi
done

# ── Commit and push ───────────────────────────────────────────────────────────

git add VERSION Sources/GetClearKit/SuiteVersion.swift Sources/GetClear/Version.swift
for i in "${!TOOL_NAMES[@]}"; do
  git add "${TOOL_DIRS[$i]}/Sources/${TOOL_SOURCES[$i]}/Version.swift"
done

git commit -m "Bump suite version to $NEW_SUITE"
git push origin main

echo ""
echo "Done: suite $OLD_SUITE → $NEW_SUITE"
echo "CI is building. Watch it at: https://github.com/kscott/get-clear/actions"
echo ""
echo "When CI passes, trigger the PKG release:"
echo "  gh workflow run release.yml --repo kscott/get-clear"
