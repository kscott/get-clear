#!/usr/bin/env bash
# bump-version — update the Get Clear suite version and push
#
# Updates major.minor across all tool repos. Each tool's patch version
# is preserved — only the major.minor is synced.
#
# Usage:
#   ./scripts/bump-version 1.3.0

set -euo pipefail

NEW="$1"

if [[ -z "$NEW" ]]; then
  echo "Usage: ./scripts/bump-version <version>"
  echo "Current: $(cat VERSION)"
  exit 1
fi

OLD=$(cat VERSION)

if [[ "$NEW" == "$OLD" ]]; then
  echo "Already at $NEW — nothing to do."
  exit 0
fi

# Extract major.minor from new version
NEW_MAJOR_MINOR=$(echo "$NEW" | cut -d. -f1-2)

TOOLS=(reminders-cli calendar-cli contacts-cli mail-cli text-cli)
TOOL_SOURCES=(RemindersCLI CalendarCLI ContactsCLI MailCLI TextCLI)

# ── Update get-clear umbrella ──────────────────────────────────────────────────

# get-clear umbrella always matches the full suite version exactly
echo "$NEW" > VERSION
printf "// Generated — do not edit manually. Use scripts/bump-version in get-clear.\nlet builtVersion = \"$NEW\"\n" \
  > Sources/GetClear/Version.swift
git add VERSION Sources/GetClear/Version.swift
git commit -m "Bump version to $NEW"
git push origin main
echo "get-clear: $OLD → $NEW"

# ── Update each tool repo ──────────────────────────────────────────────────────

for i in "${!TOOLS[@]}"; do
  tool="${TOOLS[$i]}"
  src="${TOOL_SOURCES[$i]}"
  repo="$HOME/dev/$tool"

  if [[ ! -d "$repo" ]]; then
    echo "  skipped $tool (not found at $repo)"
    continue
  fi

  # Preserve existing patch version, update major.minor
  OLD_TOOL=$(cat "$repo/VERSION" 2>/dev/null || echo "0.0.0")
  OLD_PATCH=$(echo "$OLD_TOOL" | cut -d. -f3)
  NEW_TOOL="$NEW_MAJOR_MINOR.$OLD_PATCH"

  if [[ "$NEW_TOOL" == "$OLD_TOOL" ]]; then
    echo "  $tool: already at $NEW_TOOL — skipped"
    continue
  fi

  echo "$NEW_TOOL" > "$repo/VERSION"
  printf "// Generated — do not edit manually. Use scripts/bump-version in get-clear.\nlet builtVersion = \"$NEW_TOOL\"\n" \
    > "$repo/Sources/$src/Version.swift"

  (cd "$repo" && git add VERSION "Sources/$src/Version.swift" \
    && git commit -m "Bump version to $NEW_TOOL (suite $NEW)" \
    && git push origin main)

  echo "  $tool: $OLD_TOOL → $NEW_TOOL"
done

echo ""
echo "Done: $OLD → $NEW"
echo "Waiting for tool binaries to be published..."

# Record when we started pushing — used to verify each binary is freshly built,
# not the pre-existing one at releases/latest.
PUSH_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Poll each tool repo until the signed binary at releases/latest was uploaded
# after PUSH_TIME. Each tool CI takes ~1-2 minutes; timeout after 10 minutes.
TOOL_BINS=(reminders calendar contacts mail text)
TIMEOUT=600
for bin in "${TOOL_BINS[@]}"; do
  deadline=$((SECONDS + TIMEOUT))
  while [[ $SECONDS -lt $deadline ]]; do
    updated=$(gh release view latest --repo "kscott/${bin}-cli" --json assets \
      --jq ".assets[] | select(.name == \"${bin}-bin\") | .updatedAt" 2>/dev/null || true)
    if [[ -n "$updated" && "$updated" > "$PUSH_TIME" ]]; then
      echo "  ${bin}-bin ready ($updated)"
      break
    fi
    echo "  waiting for ${bin}-bin..."
    sleep 30
  done
  if [[ $SECONDS -ge $deadline ]]; then
    echo "  timeout waiting for ${bin}-bin — trigger PKG build manually:"
    echo "  gh workflow run release.yml --repo kscott/get-clear"
    exit 1
  fi
done

echo ""
echo "All binaries ready. Triggering PKG build..."
gh workflow run release.yml --repo kscott/get-clear
echo "PKG build started. Watch it at: https://github.com/kscott/get-clear/actions"
