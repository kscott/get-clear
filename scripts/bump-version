#!/usr/bin/env bash
# bump-version — update the Get Clear suite version and push
#
# Always updates suiteVersion in all tool repos.
# Optionally updates builtVersion for specific tools.
#
# Usage:
#   ./scripts/bump-version <suite-version> [tool:version ...]
#
# Examples:
#   ./scripts/bump-version 1.4.0                        # suite only
#   ./scripts/bump-version 1.4.0 reminders:1.4.0        # suite + one tool
#   ./scripts/bump-version 1.4.0 reminders:1.4.0 calendar:1.3.1

set -euo pipefail

NEW_SUITE="$1"

if [[ -z "$NEW_SUITE" ]]; then
  echo "Usage: ./scripts/bump-version <suite-version> [tool:version ...]"
  echo "Current suite: $(cat VERSION)"
  exit 1
fi

# Parse tool:version overrides from remaining args
declare -A TOOL_VERSIONS
shift
for arg in "$@"; do
  tool="${arg%%:*}"
  ver="${arg##*:}"
  TOOL_VERSIONS["$tool"]="$ver"
done

OLD_SUITE=$(cat VERSION)

if [[ "$NEW_SUITE" == "$OLD_SUITE" && ${#TOOL_VERSIONS[@]} -eq 0 ]]; then
  echo "Already at $NEW_SUITE — nothing to do."
  exit 0
fi

TOOLS=(reminders-cli calendar-cli contacts-cli mail-cli text-cli)
TOOL_NAMES=(reminders calendar contacts mail text)
TOOL_SOURCES=(RemindersCLI CalendarCLI ContactsCLI MailCLI TextCLI)

# ── Update get-clear umbrella ──────────────────────────────────────────────────

# get-clear umbrella: builtVersion == suiteVersion always
echo "$NEW_SUITE" > VERSION
printf "// Generated — do not edit manually. Use scripts/bump-version in get-clear.\nlet builtVersion = \"$NEW_SUITE\"\nlet suiteVersion = \"$NEW_SUITE\"\n" \
  > Sources/GetClear/Version.swift
git add VERSION Sources/GetClear/Version.swift
git commit -m "Bump suite version to $NEW_SUITE"
git push origin main
echo "get-clear: $OLD_SUITE → $NEW_SUITE"

# ── Update each tool repo ──────────────────────────────────────────────────────

for i in "${!TOOLS[@]}"; do
  tool="${TOOLS[$i]}"
  name="${TOOL_NAMES[$i]}"
  src="${TOOL_SOURCES[$i]}"
  repo="$HOME/dev/$tool"

  if [[ ! -d "$repo" ]]; then
    echo "  skipped $tool (not found at $repo)"
    continue
  fi

  OLD_BUILT=$(cat "$repo/VERSION" 2>/dev/null || echo "0.0.0")

  # Use explicit override if provided, otherwise keep existing builtVersion
  if [[ -v TOOL_VERSIONS[$name] ]]; then
    NEW_BUILT="${TOOL_VERSIONS[$name]}"
  else
    NEW_BUILT="$OLD_BUILT"
  fi

  # Skip if nothing changes
  if [[ "$NEW_BUILT" == "$OLD_BUILT" && "$NEW_SUITE" == "$OLD_SUITE" ]]; then
    echo "  $tool: already at $NEW_BUILT (suite $NEW_SUITE) — skipped"
    continue
  fi

  echo "$NEW_BUILT" > "$repo/VERSION"
  printf "// Generated — do not edit manually. Use scripts/bump-version in get-clear.\nlet builtVersion = \"$NEW_BUILT\"\nlet suiteVersion = \"$NEW_SUITE\"\n" \
    > "$repo/Sources/$src/Version.swift"

  msg="Bump suite version to $NEW_SUITE"
  if [[ "$NEW_BUILT" != "$OLD_BUILT" ]]; then
    msg="Bump version to $NEW_BUILT (Get Clear $NEW_SUITE)"
  fi

  (cd "$repo" && git add VERSION "Sources/$src/Version.swift" \
    && git commit -m "$msg" \
    && git push origin main)

  if [[ "$NEW_BUILT" != "$OLD_BUILT" ]]; then
    echo "  $tool: $OLD_BUILT → $NEW_BUILT (suite $NEW_SUITE)"
  else
    echo "  $tool: $OLD_BUILT unchanged, suite → $NEW_SUITE"
  fi
done

echo ""
echo "Done: suite $OLD_SUITE → $NEW_SUITE"
echo "Waiting for tool binaries to be published..."

# Record when we started pushing — used to verify each binary is freshly built,
# not the pre-existing one at releases/latest.
PUSH_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Poll each tool repo until the signed binary at releases/latest was uploaded
# after PUSH_TIME. Each tool CI takes ~1-2 minutes; timeout after 10 minutes.
TOOL_BINS=(reminders calendar contacts mail text)
TIMEOUT=600
for bin in "${TOOL_BINS[@]}"; do
  deadline=$((SECONDS + TIMEOUT))
  while [[ $SECONDS -lt $deadline ]]; do
    updated=$(gh release view latest --repo "kscott/${bin}-cli" --json assets \
      --jq ".assets[] | select(.name == \"${bin}-bin\") | .updatedAt" 2>/dev/null || true)
    if [[ -n "$updated" && "$updated" > "$PUSH_TIME" ]]; then
      echo "  ${bin}-bin ready ($updated)"
      break
    fi
    echo "  waiting for ${bin}-bin..."
    sleep 30
  done
  if [[ $SECONDS -ge $deadline ]]; then
    echo "  timeout waiting for ${bin}-bin — trigger PKG build manually:"
    echo "  gh workflow run release.yml --repo kscott/get-clear"
    exit 1
  fi
done

echo ""
echo "All binaries ready. Triggering PKG build..."
gh workflow run release.yml --repo kscott/get-clear
echo "PKG build started. Watch it at: https://github.com/kscott/get-clear/actions"
