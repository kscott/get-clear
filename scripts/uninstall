#!/usr/bin/env bash
# Get Clear — uninstaller
#
# Stops and unregisters Get Clear's background helper, removes Get Clear.app, the six commands
# in /usr/local/bin (links into the app, or a 1.3.x install's plain binaries), their zsh
# completions, and the PKG receipt. Optionally removes configuration files and saved credentials.
# Privacy decisions belong to the user; it says how to reset them (spec 018 FR-023, FR-024).
#
# Usage:
#   ~/dev/get-clear/scripts/uninstall           # prompts about config/credentials
#   ~/dev/get-clear/scripts/uninstall --purge   # removes everything without prompting
#   /usr/local/share/get-clear/uninstall.sh     # same, if installed via PKG

set -euo pipefail

PURGE=false
if [[ "${1:-}" == "--purge" ]]; then
  PURGE=true
fi

# Escalate to sudo only for the parts that need it (bin + receipt)
# Config removal runs as the original user ($SUDO_USER or $USER)
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(dscl . -read /Users/"$REAL_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || echo "$HOME")

if [[ "$EUID" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

TOOLS=(get-clear reminders calendar contacts mail text)
BIN_DIR="/usr/local/bin"
APP="/Applications/Get Clear.app"
COMPLETIONS_DIR="/usr/local/share/zsh/site-functions"

echo "Uninstalling Get Clear..."
echo ""

# Stop and unregister the helper first, in the user's own session, while the app still exists
if [[ -x "$APP/Contents/MacOS/Get Clear" ]]; then
  if launchctl asuser "$(id -u "$REAL_USER")" sudo -u "$REAL_USER" "$APP/Contents/MacOS/Get Clear" unregister; then
    echo "  stopped and unregistered the background helper"
  else
    echo "  couldn't unregister the background helper; remove Get Clear in System Settings → General → Login Items"
  fi
fi

# Remove the commands: links into the app, or a 1.3.x install's plain binaries
for tool in "${TOOLS[@]}"; do
  target="$BIN_DIR/$tool"
  if [[ -e "$target" || -L "$target" ]]; then
    rm "$target"
    echo "  removed $target"
  else
    echo "  not found: $target"
  fi
done

# Remove the app
if [[ -d "$APP" ]]; then
  rm -rf "$APP"
  echo "  removed $APP"
fi

# Remove zsh completions
for tool in "${TOOLS[@]}"; do
  rm -f "$COMPLETIONS_DIR/_$tool"
done
echo "  removed zsh completions"

# Remove the shared directory (includes this uninstall script if run from PKG install)
if [[ -d "/usr/local/share/get-clear" ]]; then
  rm -rf "/usr/local/share/get-clear"
  echo "  removed /usr/local/share/get-clear"
fi

# Forget the PKG receipt
if pkgutil --pkg-info com.kenscott.get-clear &>/dev/null; then
  pkgutil --forget com.kenscott.get-clear
  echo "  package receipt removed"
fi

# Config and credentials
if [[ "$PURGE" == false ]]; then
  echo ""
  printf "  Remove configuration files and saved credentials? [y/N] "
  read -r answer < /dev/tty
  [[ "$answer" =~ ^[Yy]$ ]] && PURGE=true
fi

if [[ "$PURGE" == true ]]; then
  echo ""

  # Mail Keychain token
  if sudo -u "$REAL_USER" security delete-generic-password -s "mail-cli" &>/dev/null; then
    echo "  removed mail credentials from Keychain"
  fi

  # Mail config
  MAIL_CONFIG="$REAL_HOME/.config/mail-cli"
  if [[ -d "$MAIL_CONFIG" ]]; then
    rm -rf "$MAIL_CONFIG"
    echo "  removed $MAIL_CONFIG"
  fi

  # Calendar config
  CAL_CONFIG="$REAL_HOME/.config/calendar-cli"
  if [[ -d "$CAL_CONFIG" ]]; then
    rm -rf "$CAL_CONFIG"
    echo "  removed $CAL_CONFIG"
  fi

  # Activity log (future)
  GC_LOG="$REAL_HOME/.local/share/get-clear"
  if [[ -d "$GC_LOG" ]]; then
    rm -rf "$GC_LOG"
    echo "  removed $GC_LOG"
  fi
fi

echo ""
echo "Done. Get Clear uninstalled."
echo ""
echo "macOS keeps the permissions you gave Get Clear. To clear them too, run:"
echo "  tccutil reset All com.kenscott.get-clear"
