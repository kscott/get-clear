#!/usr/bin/env bash
# build-icon — render assets/GetClear.svg into assets/GetClear.icns.
#
# The SVG is the source of truth; the .icns is generated from it and committed
# so the app build doesn't need librsvg. Re-run after any change to the SVG.
#
# Usage: ./scripts/build-icon

set -euo pipefail
cd "$(dirname "$0")/.."

command -v rsvg-convert &>/dev/null || { echo "rsvg-convert not found — run: brew install librsvg"; exit 1; }

src=assets/GetClear.svg
out=assets/GetClear.icns
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
set_dir="$work/GetClear.iconset"
mkdir "$set_dir"

# iconutil's required names: icon_<pt>x<pt>[@2x].png for 16, 32, 128, 256, 512.
for pt in 16 32 128 256 512; do
    rsvg-convert -w "$pt" -h "$pt" "$src" -o "$set_dir/icon_${pt}x${pt}.png"
    rsvg-convert -w $((pt * 2)) -h $((pt * 2)) "$src" -o "$set_dir/icon_${pt}x${pt}@2x.png"
done

iconutil -c icns "$set_dir" -o "$out"
echo "Wrote $out"
