#!/bin/bash
# Post-install: register Get Clear's background helper for the logged-in user, then open the
# setup guide in their browser. Runs as root, so both happen in the console user's session.
#
# Registering here is a head start, not a requirement: if it fails, the first command that
# needs the helper registers it itself. So a failure is logged and never fails the install.

app="/Applications/Get Clear.app"
label="com.kenscott.get-clear.helper"

user="${INSTALLER_USER:-}"
if [[ -z "$user" || "$user" == "root" ]]; then
    user=$(stat -f%Su /dev/console)
fi

if [[ -n "$user" && "$user" != "root" ]]; then
    uid=$(id -u "$user")
    # Hand the app to the user, as dragging it into Applications would, so `get-clear update`
    # can replace it later with no password (spec 018 R8).
    chown -R "$user:admin" "$app"
    if ! launchctl asuser "$uid" sudo -u "$user" "$app/Contents/MacOS/Get Clear" register; then
        echo "Get Clear: helper not registered now; the first command will register it."
    fi
    # On an upgrade, stop the previous version's helper so the next command starts this one.
    launchctl asuser "$uid" launchctl kill TERM "gui/$uid/$label" 2>/dev/null || true
    sudo -u "$user" open "https://github.com/kscott/get-clear#get-started" 2>/dev/null || true
fi

exit 0
