#!/bin/bash
# Blocks push on a SwiftLint error, a SwiftLint crash, or a SwiftFormat violation.
# SwiftLint warnings pass — run `swiftlint lint` to review, `swiftlint --fix && swiftformat .` to clean.
# All logic lives in scripts/lint (single source of truth; run it directly to check locally).

set -uo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/lint"
